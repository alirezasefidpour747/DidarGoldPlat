{
  "name": "didar-gold-kernel",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:all": "tsx scripts/dev.ts",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:client": "vite --host 0.0.0.0",
    "dev:backend": "tsx server.ts",
    "dev:server": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:frontend": "vite build",
    "build:backend": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "bun dist/server.cjs",
    "start:backend": "bun dist/server.cjs",
    "start:frontend": "vite preview --port 3000 --host 0.0.0.0",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "scan:secrets": "bun scripts/secret-scan.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:status": "bun scripts/db-status.ts",
    "db:import:k01": "bun scripts/import-k01.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4",
    "@types/express": "^4.17.21"
  }
}
