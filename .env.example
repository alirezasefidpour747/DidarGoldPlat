# Didar Gold runtime configuration template
# Copy to an ignored .env file for local use. Never commit usable credentials.

# NODE_ENV
# Optional in development; required value is set to production by the container.
# Implemented: controls production configuration validation and CORS behavior.
NODE_ENV=development

# FRONTEND_PORT
# Optional; development/Vite only. Implemented. Safe local example shown.
FRONTEND_PORT=3000

# PORT / BACKEND_PORT
# Optional in development; container sets both explicitly to the same port.
# BACKEND_PORT takes precedence. Implemented. Safe local example shown.
PORT=8000
BACKEND_PORT=8000

# VITE_API_BASE_URL
# Optional; development/build-time browser API URL. Implemented.
# In the single-container production image, leave empty to use same-origin /api.
VITE_API_BASE_URL=http://127.0.0.1:8000

# CORS_ALLOWED_ORIGINS
# Required in production; optional in development, where documented localhost
# origins are added. Implemented as a comma-separated exact browser allowlist.
CORS_ALLOWED_ORIGINS=https://app.example.invalid,https://admin.example.invalid

# SERVE_STATIC
# Required to be explicitly true or false in production. Implemented.
# The current single-container image sets true and serves the built Vite SPA.
SERVE_STATIC=false

# DATABASE_URL
# Required in production and for the active K01 runtime. Implemented with a
# pooled PostgreSQL connection; readiness verifies it with a real SELECT 1.
# Format: postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# DATABASE_POOL_MAX / DATABASE_IDLE_TIMEOUT_MS / DATABASE_CONNECT_TIMEOUT_MS
# Optional PostgreSQL pool tuning. Implemented. Safe development defaults shown.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=3000

# DATABASE_QUERY_TIMEOUT_MS / DATABASE_READINESS_TIMEOUT_MS
# Optional query/readiness limits. Implemented. Values are milliseconds.
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_READINESS_TIMEOUT_MS=2000

# K01_IMPORT_FILE / K01_IMPORT_BACKUP_DIR
# Optional operator-only import tooling; unavailable in the approved clean-schema
# deployment because the legacy K01 JSON is owner-classified demo data.
# No import runs at startup. Leave K01_IMPORT_FILE empty.
K01_IMPORT_FILE=
K01_IMPORT_BACKUP_DIR=data/import-backups

# PostgreSQL container bootstrap settings
# Required by Docker Compose only. Implemented for PostgreSQL initialization;
# migrations remain an explicit operator/CI action and never run at startup.
POSTGRES_DB=didar_gold
POSTGRES_USER=didar_app
POSTGRES_PASSWORD=

# JWT_SECRET
# Reserved only; optional and UNUSED because authentication is not implemented.
# Do not set this as evidence of JWT security. No usable example is provided.
JWT_SECRET=

# GEMINI_API_KEY
# Optional/reserved. AI integration is currently unavailable/not implemented.
GEMINI_API_KEY=

# DISABLE_HMR
# Optional; development/Vite only. Implemented. Set true to disable HMR/watch.
DISABLE_HMR=false
