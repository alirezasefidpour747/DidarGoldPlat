# Didar Gold Platform - Self-Hosted Environment Configuration
# 100% Independent: Zero dependency on Supabase or external cloud services.

# Application Port (Default 3000)
PORT=3000
NODE_ENV=production

# Server URL
APP_URL=http://localhost:3000

# Standalone Database Configuration (Optional for PostgreSQL)
# If omitted, the engine uses the high-performance transactional ACID disk store in /data.
# For self-hosted PostgreSQL: postgresql://postgres:password@localhost:5432/didar_gold
DATABASE_URL=

# JWT Secret for Independent Token Signing
JWT_SECRET=didar_gold_kernel_secret_key_change_in_production

# GEMINI_API_KEY: Optional for AI Studio assistance
GEMINI_API_KEY=
